+#[tokio::test]
+async fn mailbox_legacy_retry_accepts_sender_context_without_rewriting_message() {
+    let runtime = StateRuntime::init_for_testing(
+        test_support::unique_temp_dir(),
+        "test-provider".to_string(),
+    )
+    .await
+    .expect("state runtime");
+    let recipient = ThreadId::new();
+    let legacy = communication("legacy-message");
+    assert!(
+        serde_json::to_value(&legacy)
+            .expect("legacy payload")
+            .get("sender_thread_id")
+            .is_none()
+    );
+    runtime
+        .admit_agent_message(recipient, &legacy, /*now_ms*/ 1_000)
+        .await
+        .expect("legacy admission");
+    let stored_before = runtime
+        .get_agent_message("legacy-message")
+        .await
+        .expect("lookup")
+        .expect("stored message");
+    let mut retry = legacy.clone();
+    retry.sender_thread_id = Some(ThreadId::new());
+    retry.created_at_ms = Some(9_999);
+    assert_eq!(
+        runtime
+            .admit_agent_message(recipient, &retry, /*now_ms*/ 1_001)
+            .await
+            .expect("retry with sending-thread context"),
+        AgentMailboxAdmission::Existing(AgentMailboxPhase::Admitted)
+    );
+    assert_eq!(
+        runtime
+            .get_agent_message("legacy-message")
+            .await
+            .expect("lookup")
+            .expect("stored message"),
+        stored_before
+    );
+
+    retry.content = "different work".to_string();
+    let error = runtime
+        .admit_agent_message(recipient, &retry, /*now_ms*/ 1_002)
+        .await
+        .expect_err("new sender context must not hide a changed body");
+    assert!(
+        error
+            .to_string()
+            .contains("conflicts with a different message")
+    );
+}
+
+#[tokio::test]
+async fn mailbox_known_sender_identity_remains_collision_checked() {
+    let runtime = StateRuntime::init_for_testing(
+        test_support::unique_temp_dir(),
+        "test-provider".to_string(),
+    )
+    .await
+    .expect("state runtime");
+    let recipient = ThreadId::new();
+    let mut message = communication("attributed-message");
+    message.sender_thread_id = Some(ThreadId::new());
+    runtime
+        .admit_agent_message(recipient, &message, /*now_ms*/ 1_000)
+        .await
+        .expect("first admission");
+    assert_eq!(
+        runtime
+            .admit_agent_message(recipient, &message, /*now_ms*/ 1_001)
+            .await
+            .expect("same known sender retry"),
+        AgentMailboxAdmission::Existing(AgentMailboxPhase::Admitted)
+    );
+
+    let mut other_sender = message.clone();
+    other_sender.sender_thread_id = Some(ThreadId::new());
+    let mut missing_sender = message.clone();
+    missing_sender.sender_thread_id = None;
+    let mut changed_body = message.clone();
+    changed_body.content = "different work".to_string();
+    for conflicting in [other_sender, missing_sender, changed_body] {
+        let error = runtime
+            .admit_agent_message(recipient, &conflicting, /*now_ms*/ 1_002)
+            .await
+            .expect_err("known attribution and canonical body must remain checked");
+        assert!(
+            error
+                .to_string()
+                .contains("conflicts with a different message")
+        );
+    }
+    assert_eq!(
+        runtime
+            .get_agent_message("attributed-message")
+            .await
+            .expect("lookup")
+            .expect("stored message")
+            .communication,
+        message
+    );
+}
