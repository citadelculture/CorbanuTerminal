+/// #1142: these values are programs, even when their literal shell text
+/// does not itself mention a protected path. No Git/pager is executed.
+#[test]
+fn issue_1142_command_environment_prefixes_ask() {
+    for name in [
+        "GIT_PAGER",
+        "PAGER",
+        "GIT_EDITOR",
+        "EDITOR",
+        "VISUAL",
+        "GIT_SEQUENCE_EDITOR",
+        "GIT_SSH",
+        "GIT_SSH_COMMAND",
+        "GIT_EXTERNAL_DIFF",
+        "GIT_ASKPASS",
+        "LESSOPEN",
+        "LESSCLOSE",
+    ] {
+        let line = format!("{name}='touch marker' git log");
+        assert_eq!(
+            script(&line),
+            Some(ProtectedActionKind::UnseenCode),
+            "{line}"
+        );
+    }
+    for line in [
+        "env GIT_PAGER='touch marker' git log",
+        "env -i GIT_PAGER='touch marker' git log",
+        "env -- GIT_PAGER='touch marker' /usr/bin/git log",
+        "GIT_PAGER='touch marker' command -- git log",
+        "export GIT_PAGER=marker; timeout -k 1 2 nice -n 1 git log",
+    ] {
+        assert_eq!(
+            script(line),
+            Some(ProtectedActionKind::UnseenCode),
+            "{line}"
+        );
+    }
+}
+
+#[test]
+fn issue_1142_command_environment_writers_ask() {
+    for line in [
+        "GIT_PAGER='touch marker'; git log",
+        "export GIT_PAGER='touch marker'; git log",
+        "declare -x GIT_PAGER='touch marker'; git log",
+        "typeset -x GIT_PAGER='touch marker'; git log",
+        "readonly GIT_PAGER='touch marker'; git log",
+        "printf -v GIT_PAGER %s 'touch marker'; git log",
+        "printf -v PAGER %s 'touch marker'; git log",
+        "builtin printf -vGIT_PAGER %s 'touch marker'; git log",
+        "read -r GIT_PAGER; git log",
+        "read -t 1 -r GIT_PAGER; git log",
+        "read -a GIT_PAGER; git log",
+        "GIT_PAGER+=cat; git log",
+    ] {
+        assert_eq!(
+            script(line),
+            Some(ProtectedActionKind::UnseenCode),
+            "{line}"
+        );
+    }
+}
+
+#[test]
+fn issue_1142_command_environment_is_inherited_by_shell_scripts() {
+    for line in [
+        "GIT_PAGER='touch marker' bash -lc 'git log'",
+        "export GIT_PAGER='touch marker'; bash -lc 'git log'",
+        "export GIT_PAGER=marker; env --split-string='git log'",
+        "GIT_PAGER=marker env --split-string='git log'",
+        "export GIT_PAGER=marker; command env --split-string='git log'",
+        "export GIT_PAGER=marker; flock guard --command='git log'",
+        "env GIT_PAGER='touch marker' sh -c 'git log'",
+        "printf %s \"$(printf -v GIT_PAGER %s 'touch marker'; git log)\"",
+    ] {
+        assert_eq!(
+            script(line),
+            Some(ProtectedActionKind::UnseenCode),
+            "{line}"
+        );
+    }
+    assert_eq!(
+        kind(&["env", "GIT_PAGER=touch marker", "bash", "-lc", "git log"]),
+        Some(ProtectedActionKind::UnseenCode),
+    );
+}
