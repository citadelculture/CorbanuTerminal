+        "PAGER=cat git log",
+        "export GIT_PAGER=cat; git log",
+        "env PAGER=cat GIT_PAGER=cat git log",
+        "git log",
+    ] {
+        assert_eq!(script(line), None, "{line}");
+    }
+}
