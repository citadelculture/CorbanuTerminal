+#[test]
+fn issue_1142_command_environment_inspection_and_option_values_stay_data() {
+    for line in [
+        "env -u GIT_PAGER git log",
+        "env --unset=GIT_PAGER git log",
+        "env -C GIT_PAGER=marker git log",
+        "env --chdir GIT_PAGER=marker git log",
+        "exec -a GIT_PAGER=marker git log",
+        "declare -p GIT_PAGER; git log",
+        "export -p GIT_PAGER; git log",
+        "read -p GIT_PAGER answer; git log",
+        "GIT_PAGER='touch marker'; command -v git",
+        "GIT_PAGER='touch marker'; command -V git",
+        "GIT_PAGER='touch marker'; env --help git",
+        "GIT_PAGER='touch marker'; exec -a git printf ok",
+    ] {
+        assert_eq!(script(line), None, "{line}");
+    }
+}
