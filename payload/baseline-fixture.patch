+#[test]
+fn substitution_blanking_keeps_exact_text() {
+    for (text, expected) in [
+        ("", ""),
+        ("名字 + n + $v", "名字 + n + $v"),
+        ("a$(date +%s)b", "a b"),
+        ("a$(nested $(x))b", "a b"),
+        ("a`date`b", "a b"),
+        ("a`unfinished", "a "),
+        ("a$(unfinished", "a "),
+        ("$((n + 1))", "$((n + 1))"),
+        ("a$(x)b`y`c", "a b c"),
+    ] {
+        assert_eq!(without_substitutions(text).as_ref(), expected, "{text}");
+    }
+}
