+#[test]
+fn issue_1142_command_environment_temporary_writes_do_not_escape() {
+    for line in [
+        "GIT_PAGER=cat printf '%s' ok; git log",
+        "GIT_PAGER='touch marker' true; git log",
+        "env GIT_PAGER='touch marker' true; git log",
+        "env GIT_PAGER='touch marker'; git log",
+        "env printf -v GIT_PAGER %s marker; git log",
+        "bash -c 'GIT_PAGER=marker'; git log",
+        "printf %s \"$(printf -v GIT_PAGER %s 'touch marker')\"; git log",
+    ] {
+        assert_eq!(script(line), None, "{line}");
+    }
+}
