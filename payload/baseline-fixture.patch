+#[test]
+fn issue_1142_command_environment_does_not_replace_stronger_findings() {
+    assert_eq!(
+        script("GIT_PAGER='touch marker' git log; cat ~/.ssh/id_rsa"),
+        Some(ProtectedActionKind::Credentials),
+    );
+}
