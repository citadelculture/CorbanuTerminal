+#[test]
+fn an_exited_process_does_not_hide_a_later_mount_view() {
+    for error in [
+        io::Error::from(io::ErrorKind::NotFound),
+        io::Error::from_raw_os_error(libc::ESRCH),
+        io::Error::from_raw_os_error(libc::EINVAL),
+    ] {
+        let temp = tempfile::TempDir::new().expect("tempdir");
+        let exited = process_in_mount_namespace(temp.path(), "101");
+        let live = process_in_mount_namespace(temp.path(), "102");
+        let duplicate = process_in_mount_namespace(temp.path(), "103");
+        let exited_mountinfo = exited.join("mountinfo");
+        let live_mountinfo = live.join("mountinfo");
+        let mut exit_error = Some(error);
+        let mut reads = Vec::new();
+
+        let points = mount_points_for_processes([exited, live, duplicate].into_iter(), |path| {
+            reads.push(path.to_path_buf());
+            if path == exited_mountinfo.as_path() {
+                return Err(exit_error.take().expect("first process read once"));
+            }
+            assert_eq!(
+                path,
+                live_mountinfo.as_path(),
+                "a successful view is deduplicated"
+            );
+            Ok(b"1 0 0:1 / /held-mount rw - tmpfs tmpfs rw\n".to_vec())
+        });
+
+        assert_eq!(points, Some(HashSet::from([b"/held-mount".to_vec()])));
+        assert_eq!(reads, vec![exited_mountinfo, live_mountinfo]);
+    }
+}
+
+#[test]
+fn a_mountinfo_read_error_still_fails_closed() {
+    let temp = tempfile::TempDir::new().expect("tempdir");
+    let first = process_in_mount_namespace(temp.path(), "101");
+    let later = process_in_mount_namespace(temp.path(), "102");
+    let expected_read = first.join("mountinfo");
+    let mut reads = Vec::new();
+
+    let points = mount_points_for_processes([first, later].into_iter(), |path| {
+        reads.push(path.to_path_buf());
+        Err(io::Error::from(io::ErrorKind::PermissionDenied))
+    });
+
+    assert_eq!(points, None);
+    assert_eq!(reads, vec![expected_read]);
+}
