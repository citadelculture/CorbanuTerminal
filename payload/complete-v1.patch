+fn process_in_mount_namespace(base: &Path, pid: &str) -> PathBuf {
+    let process = base.join(pid);
+    std::fs::create_dir_all(process.join("ns")).expect("process namespace folder");
+    std::os::unix::fs::symlink("mnt:[1]", process.join("ns/mnt")).expect("namespace link");
+    process
+}
