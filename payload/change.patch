+        "cat <<'END'\nGIT_PAGER=marker git log\nEND",
+        "git log; GIT_PAGER=marker",
+        "git_pager=marker git log",
+        "cat <<'END'\nGIT_PAGER=marker\nEND\ngit log",
+        "GIT_PAGER='touch marker'; printf %s git",
+        "GIT_PAGER='touch marker' less notes",
+        "MANPAGER='touch marker' git log",
+        "env --split-string='git log'",
+        "command env --split-string='git log'",
+        "export GIT_PAGER=marker; printf %s env --split-string='git log'",
+        "flock guard --command='git log'",
+        "export GIT_PAGER=marker; printf %s \"env --split-string='git log'\"",
+        "ordinary='touch marker' git log",
+    ] {
+        assert_eq!(script(line), None, "{line}");
+    }
+}
