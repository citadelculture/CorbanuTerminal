+/// A later reset does not prove which branch ran. This is a conservative
+/// command-line analysis, not a shell/environment evaluator.
+#[test]
+fn issue_1142_command_environment_conservative_boundaries_ask() {
+    for line in [
+        "GIT_PAGER='touch marker'; unset GIT_PAGER; git log",
+        "GIT_PAGER='touch marker'; GIT_PAGER=cat; git log",
+        "if false; then GIT_PAGER='touch marker'; fi; git log",
+        "GIT_PAGER='touch marker'; env -u GIT_PAGER git log",
+        // The word reader does not retain whether the assignment operator
+        // itself was quoted. Preserve that conservative ambiguity.
+        "'GIT_PAGER=marker' git log",
+        // Direct data writes do not contribute, but the existing shared
+        // script discovery may re-read shell-shaped quoted data as code.
+        "printf '%s' \"bash -c 'GIT_PAGER=marker; git log'\"",
+    ] {
+        assert_eq!(
+            script(line),
+            Some(ProtectedActionKind::UnseenCode),
+            "{line}"
+        );
+    }
+}
