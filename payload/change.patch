+/// #943 item 3: an approval held by a planted finding and the refused retry
+/// belong to one command. Keep the note once, with the protected read still held.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn issue_943_held_note_is_sent_once_when_approval_and_retry_are_held() -> anyhow::Result<()> {
+    skip_if_no_network!(Ok(()));
+    skip_if_sandbox!(Ok(()));
+    let mut wrong = Vec::new();
+    for planted in [false, true] {
+        let outside = TempDir::new()?;
+        let outside_path = outside.path().canonicalize()?;
+        std::fs::write(outside_path.join("zshrc"), "# start-up\n")?;
+        let home = Arc::new(TempDir::new()?);
+        let auth = home.path().canonicalize()?.join("auth.json");
+        std::fs::write(&auth, CANARY)?;
+        let first = if planted {
+            plant(&outside_path)
+        } else {
+            "printf 'tidied'".to_string()
+        };
+        let (run, _) = run(
+            SecurityLevel::Moderate,
+            Setting::FullAccess,
+            home,
+            vec![
+                step("call-first", json!({ "command": first })),
+                step(
+                    "call-read",
+                    json!({
+                        "command": format!("cat '{}'", auth.display()),
+                        "sandbox_permissions": "require_escalated",
+                        "justification": "check the sign-in",
+                    }),
+                ),
+            ],
+        )
+        .await?;
+        let held_notes = run
+            .warnings
+            .iter()
+            .filter(|warning| {
+                warning.starts_with("The approval doesn't lift the protected-file rules")
+            })
+            .collect::<Vec<_>>();
+        let expected_held_note_count = usize::from(planted);
+        if held_notes.len() != expected_held_note_count {
+            wrong.push(format!(
+                "planted={planted}: expected {expected_held_note_count} held-back note(s), got {}: \
+                 {held_notes:?}",
+                held_notes.len()
+            ));
+        }
+        let read = output(&run.requests, "call-read");
+        // Asked and approved either way; lifted only without the finding.
+        if run.asked == 0 || read.contains(CANARY) == planted {
+            wrong.push(format!(
+                "planted={planted}: asked={} warnings={:?} read={read}",
+                run.asked, run.warnings
+            ));
+        }
+    }
+    assert_eq!(wrong, Vec::<String>::new());
+    Ok(())
+}
