+        "VISUAL='touch marker' less notes",
+        "PAGER='touch marker' man git",
+        "MANPAGER='touch marker' man git",
+        "LESSOPEN='touch marker' man git",
+    ] {
+        assert_eq!(
+            script(line),
+            Some(ProtectedActionKind::UnseenCode),
+            "{line}"
+        );
+    }
+}
