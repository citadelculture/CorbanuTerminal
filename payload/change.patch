+/// #1142: these values are programs, even when their literal shell text
+/// does not itself mention a protected path. No Git/pager is executed.
+#[test]
+fn issue_1142_command_environment_prefixes_ask() {
+    for name in [
+        "GIT_PAGER",
+        "PAGER",
+        "GIT_EDITOR",
+        "EDITOR",
+        "VISUAL",
+        "GIT_SEQUENCE_EDITOR",
+        "GIT_SSH",
+        "GIT_SSH_COMMAND",
+        "GIT_EXTERNAL_DIFF",
+        "GIT_ASKPASS",
+        "LESSOPEN",
+        "LESSCLOSE",
+    ] {
+        let line = format!("{name}='touch marker' git log");
+        assert_eq!(
+            script(&line),
+            Some(ProtectedActionKind::UnseenCode),
+            "{line}"
+        );
+    }
+    for line in [
+        "env GIT_PAGER='touch marker' git log",
+        "env -i GIT_PAGER='touch marker' git log",
+        "env -- GIT_PAGER='touch marker' /usr/bin/git log",
+        "GIT_PAGER='touch marker' command -- git log",
+        "export GIT_PAGER=marker; timeout -k 1 2 nice -n 1 git log",
+    ] {
+        assert_eq!(
+            script(line),
+            Some(ProtectedActionKind::UnseenCode),
+            "{line}"
+        );
+    }
+}
