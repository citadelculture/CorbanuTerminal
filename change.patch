@@ -0,0 +1,180 @@
+use super::*;
+use codex_protocol::AgentPath;
+use codex_protocol::protocol::AgentMessageKind;
+use codex_protocol::protocol::InterAgentCommunication;
+use codex_state::AgentMailboxAdmission;
+use codex_state::AgentMailboxMessage;
+use codex_state::AgentMailboxPhase;
+
+const SEED_PROMPT: &str = "issue1177 control turn one";
+const RESULT_TEXT: &str = "issue1177 controlled terminal result";
+const MESSAGE_ID: &str = "issue1177-controlled-result";
+
+async fn parent_with_persisted_result(
+    server: &MockServer,
+) -> Result<(TestCodex, InterAgentCommunication)> {
+    mount_sse_once_match(
+        server,
+        |request: &wiremock::Request| body_contains(request, SEED_PROMPT),
+        sse(vec![
+            ev_response_created("issue1177-seed"),
+            ev_assistant_message("issue1177-seed-message", "parent ready"),
+            ev_completed("issue1177-seed"),
+        ]),
+    )
+    .await;
+    let test = test_codex()
+        .with_config(|config| {
+            config
+                .features
+                .enable(Feature::Collab)
+                .expect("enable collab");
+            config
+                .features
+                .enable(Feature::MultiAgentV2)
+                .expect("enable v2");
+        })
+        .build_with_auto_env(server)
+        .await?;
+    test.submit_turn(SEED_PROMPT).await?;
+    let mut communication = InterAgentCommunication::new(
+        AgentPath::try_from("/root/worker").expect("worker path should parse"),
+        AgentPath::root(),
+        Vec::new(),
+        RESULT_TEXT.to_string(),
+        /*trigger_turn*/ false,
+    )
+    .with_kind(AgentMessageKind::TerminalResult)
+    .with_message_id(MESSAGE_ID);
+    communication.created_at_ms = Some(1_000);
+    let state_db = test.codex.state_db().expect("mailbox state db");
+    assert_eq!(
+        state_db
+            .admit_agent_message(
+                test.session_configured.thread_id,
+                &communication,
+                /*now_ms*/ 1_000
+            )
+            .await?,
+        AgentMailboxAdmission::Inserted
+    );
+    assert!(
+        state_db
+            .transition_agent_message(
+                MESSAGE_ID,
+                AgentMailboxPhase::Admitted,
+                AgentMailboxPhase::Ready,
+                /*now_ms*/ 1_001
+            )
+            .await?
+    );
+    assert_eq!(
+        state_db
+            .list_recoverable_agent_messages(test.session_configured.thread_id)
+            .await?,
+        vec![AgentMailboxMessage {
+            recipient_thread_id: test.session_configured.thread_id,
+            communication: communication.clone(),
+            phase: AgentMailboxPhase::Ready,
+            attempt_id: None,
+            created_at_ms: 1_000,
+            updated_at_ms: 1_001,
+        }]
+    );
+    assert!(!has_pending_mailbox_items(&test.codex).await);
+    Ok((test, communication))
+}
+
+async fn capture_control_turn_two(
+    test: &TestCodex,
+    server: &MockServer,
+) -> Result<Vec<ResponsesRequest>> {
+    let turn2 = mount_sse_once_match(
+        server,
+        |request: &wiremock::Request| body_contains(request, TURN_2_NO_WAIT_PROMPT),
+        sse(vec![
+            ev_response_created("issue1177-turn2"),
+            ev_assistant_message("issue1177-turn2-message", "control complete"),
+            ev_completed("issue1177-turn2"),
+        ]),
+    )
+    .await;
+    test.submit_turn(TURN_2_NO_WAIT_PROMPT).await?;
+    let requests = wait_for_requests(&turn2).await?;
+    assert!(
+        requests
+            .iter()
+            .all(|request| request.body_contains_text(TURN_2_NO_WAIT_PROMPT))
+    );
+    Ok(requests)
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn persisted_row_waits_for_delivery_then_reaches_turn_two() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = start_mock_server().await;
+    let (test, communication) = parent_with_persisted_result(&server).await?;
+    let readiness = wait_for_parent_mailbox(&test);
+    tokio::pin!(readiness);
+    // Hold delivery while observing the exact shared wait. This is a bounded
+    // no-delivery phase, not a sleep used as evidence that mail has arrived.
+    assert!(
+        tokio::time::timeout(Duration::from_millis(50), readiness.as_mut())
+            .await
+            .is_err()
+    );
+    assert!(!has_pending_mailbox_items(&test.codex).await);
+    test.codex
+        .submit(Op::InterAgentCommunication { communication })
+        .await?;
+    readiness.await?;
+    assert!(has_pending_mailbox_items(&test.codex).await);
+    let turn2_requests = capture_control_turn_two(&test, &server).await?;
+    assert!(turn2_requests.iter().any(has_subagent_notification));
+    assert!(
+        turn2_requests
+            .iter()
+            .any(|request| request.body_contains_text(RESULT_TEXT))
+    );
+    eprintln!("ISSUE1177_EXECUTED:controlled_delivery_gap");
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn undelivered_row_times_out_and_turn_two_oracle_rejects() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = start_mock_server().await;
+    let (test, communication) = parent_with_persisted_result(&server).await?;
+    // No delivery operation or background sender is created in this case.
+    let started = Instant::now();
+    let error = wait_for_parent_mailbox(&test)
+        .await
+        .expect_err("undelivered mail must time out");
+    assert!(
+        error
+            .downcast_ref::<tokio::time::error::Elapsed>()
+            .is_some()
+    );
+    assert!(started.elapsed() >= POSITIVE_WAIT);
+    assert!(!has_pending_mailbox_items(&test.codex).await);
+    let rows = test
+        .codex
+        .state_db()
+        .expect("mailbox state db")
+        .list_recoverable_agent_messages(test.session_configured.thread_id)
+        .await?;
+    assert_eq!(rows.len(), 1);
+    assert_eq!(rows[0].communication, communication);
+    assert_eq!(rows[0].phase, AgentMailboxPhase::Ready);
+    // The failed delivery attempt stays failed. This separate oracle check
+    // deliberately observes turn two without delivering the persisted result.
+    let turn2_requests = capture_control_turn_two(&test, &server).await?;
+    assert!(!turn2_requests.iter().any(has_subagent_notification));
+    assert!(
+        !turn2_requests
+            .iter()
+            .any(|request| request.body_contains_text(RESULT_TEXT))
+    );
+    eprintln!("ISSUE1177_EXECUTED:undelivered_timeout_and_oracle_rejection");
+    Ok(())
+}
